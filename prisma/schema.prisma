generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BROKER
  TENANT
  TAX_ADVISOR
}

enum DocumentStatus {
  MISSING
  REQUESTED
  AVAILABLE
  SHARED
  NOT_RELEVANT
}

enum DocumentScope {
  PROPERTY
  UNIT
  TENANT
  CONTRACT
}

enum AuditAction {
  LOGIN
  FILE_UPLOADED
  FILE_VIEWED
  FILE_DOWNLOADED
  PERMISSION_CHANGED
  CONTRACT_GENERATED
  PROPERTY_CHANGED
  USER_INVITED
  BACKUP_EXPORTED
  BACKUP_IMPORTED
}

enum NetWorthAssetType {
  ASSET
  LIABILITY
}

model PortalInstance {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  timeZone    String             @default("Europe/Berlin")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  users       User[]
  properties  Property[]
  documents   Document[]
  documentExports DocumentExport[]
  publicShares PublicShare[]
  categories  DocumentCategory[]
  templates   ContractTemplate[]
  mailTemplates MailTemplate[]
  telegramBotConfig TelegramBotConfig?
  aiProviderConfig AiProviderConfig?
  bankingIntegrationConfig BankingIntegrationConfig?
  serviceChargeRules ServiceChargeRule[]
  serviceChargeStatementLines ServiceChargeStatementLine[]
  serviceChargeStatements ServiceChargeStatement[]
  propertyLoanAccountMappings PropertyLoanAccountMapping[]
  netWorthAssets NetWorthAsset[]
  agentConfig AgentConfig?
  agentConversations AgentConversation[]
  auditLogs   AuditLog[]
  apiTokens   ApiToken[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  deviceInstallations DeviceInstallation[]
  timelineEvents TimelineEvent[]
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  username     String?
  portalInstanceId String?
  platformAdmin Boolean        @default(false)
  name         String?
  contactPerson String?
  contactAddress String?
  contactPhone String?
  contactEmail String?
  ownerBankName String?
  ownerIban    String?
  ownerTaxId   String?
  ownerNotes   String?
  ownerSignaturePath String?
  passwordHash String
  role         Role            @default(TENANT)
  active       Boolean         @default(true)
  inviteToken  String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  documents    Document[]      @relation("UploadedDocuments")
  documentExports DocumentExport[]
  publicShares PublicShare[]
  permissions  AccessPermission[]
  brokerLinks  BrokerRequest[]
  brokerValuations BrokerValuation[]
  tenantProfile TenantProfile?
  auditLogs    AuditLog[]
  apiTokens    ApiToken[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  deviceInstallations DeviceInstallation[]
  createdTimelineEvents TimelineEvent[] @relation("TimelineEventActor")
  brokerTimelineEvents  TimelineEvent[] @relation("TimelineEventBroker")
  createdServiceChargeStatements ServiceChargeStatement[]
  portalInstance PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}

model OAuthClient {
  id              String          @id @default(cuid())
  clientId        String          @unique
  clientName      String?
  redirectUris    String[]        @default([])
  clientUri       String?
  logoUri         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model OAuthAuthorizationCode {
  id              String          @id @default(cuid())
  codeHash        String          @unique
  userId          String
  portalInstanceId String?
  clientId        String
  redirectUri     String
  scopes          String[]        @default([])
  codeChallenge   String
  codeChallengeMethod String      @default("S256")
  resource        String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}

model ApiToken {
  id              String          @id @default(cuid())
  portalInstanceId String?
  userId          String
  name            String
  tokenHash       String          @unique
  scopes          String[]        @default([])
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}

model DeviceInstallation {
  id              String          @id @default(cuid())
  portalInstanceId String?
  userId          String
  deviceToken     String          @unique
  platform        String          @default("ios")
  environment     String          @default("production")
  deviceName      String?
  appVersion      String?
  buildNumber     String?
  locale          String?
  timeZone        String?
  lastSeenAt      DateTime        @default(now())
  lastPushAttemptAt DateTime?
  lastPushStatus  String?
  lastPushError   String?
  revokedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}

model Property {
  id                    String          @id @default(cuid())
  portalInstanceId      String?
  name                  String
  address               String
  street                String?
  houseNumber           String?
  postalCode            String?
  city                  String?
  country               String?         @default("Deutschland")
  latitude              Float?
  longitude             Float?
  objectType            String?
  constructionYear      Int?
  livingArea            Decimal?        @db.Decimal(12, 2)
  usableArea            Decimal?        @db.Decimal(12, 2)
  plotArea              Decimal?        @db.Decimal(12, 2)
  rooms                 Decimal?        @db.Decimal(6, 2)
  unitCount             Int             @default(0)
  floor                 String?
  parkingSpaces         Int?
  energyCertificate     String?
  heatingType           String?
  condition             String?
  modernizations        String?
  rentalStatus          String?
  purchasePrice         Decimal?        @db.Decimal(14, 2)
  expectedPurchasePrice Decimal?        @db.Decimal(14, 2)
  outstandingLoan       Decimal?        @db.Decimal(14, 2)
  internalNotes         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  units                 Unit[]
  documents             Document[]
  brokerRequests        BrokerRequest[]
  brokerValuations      BrokerValuation[]
  templates             ContractTemplate[]
  todos                 PropertyTodo[]
  serviceChargeRules    ServiceChargeRule[]
  serviceChargeStatements ServiceChargeStatement[]
  loanAccountMappings PropertyLoanAccountMapping[]
  timelineEvents        TimelineEvent[]
  portalInstance        PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}

model PropertyLoanAccountMapping {
  id                String          @id @default(cuid())
  portalInstanceId  String?
  propertyId        String
  bankingAccountId  Int
  label             String?
  lastBalance       Decimal?        @db.Decimal(14, 2)
  lastBalanceAt     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  portalInstance    PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
  property          Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, bankingAccountId])
  @@index([portalInstanceId])
  @@index([bankingAccountId])
}

model NetWorthAsset {
  id                  String            @id @default(cuid())
  portalInstanceId    String?
  name                String
  type                NetWorthAssetType @default(ASSET)
  manualValue         Decimal?          @db.Decimal(14, 2)
  bankingAccountId    Int?
  bankingAccountLabel String?
  lastSyncedValue     Decimal?          @db.Decimal(14, 2)
  lastSyncedAt        DateTime?
  note                String?
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  portalInstance      PortalInstance?   @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)

  @@index([portalInstanceId, active])
  @@index([bankingAccountId])
}

model PropertyTodo {
  id          String    @id @default(cuid())
  propertyId  String
  title       String
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, completedAt])
  @@index([dueDate])
}

model Unit {
  id          String          @id @default(cuid())
  propertyId  String
  defaultContractTemplateId String?
  unitNumber  String
  floor       String?
  rooms       Decimal?        @db.Decimal(6, 2)
  livingArea  Decimal?        @db.Decimal(12, 2)
  rentAmount  Decimal?        @db.Decimal(12, 2)
  garageRent  Decimal?        @db.Decimal(12, 2)
  serviceCharges Decimal?     @db.Decimal(12, 2)
  warmRent    Decimal?        @db.Decimal(12, 2)
  status      String?
  isSharedHousing Boolean     @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  defaultContractTemplate ContractTemplate? @relation("UnitDefaultContractTemplate", fields: [defaultContractTemplateId], references: [id], onDelete: SetNull)
  documents   Document[]
  tenants     TenantProfile[]
  contracts   LeaseContract[]
  templates   ContractTemplate[] @relation("TemplateAssignedUnit")
  rentPayments RentPayment[]
  serviceChargeAllocations ServiceChargeUnitAllocation[]
  serviceChargeStatementLines ServiceChargeStatementLine[]
  timelineEvents TimelineEvent[]
}

model TimelineEvent {
  id              String      @id @default(cuid())
  portalInstanceId String?
  propertyId      String?
  unitId          String?
  tenantProfileId String?
  brokerUserId    String?
  actorUserId     String?
  eventType       String
  title           String
  description     String?     @db.Text
  status          String      @default("INFO")
  eventDate       DateTime
  endDate         DateTime?
  dueDate         DateTime?
  costAmount      Decimal?    @db.Decimal(14, 2)
  costCurrency    String      @default("EUR")
  costCategory    String?
  isInternal      Boolean     @default(false)
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
  property        Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit            Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenantProfile   TenantProfile? @relation(fields: [tenantProfileId], references: [id], onDelete: SetNull)
  brokerUser      User?       @relation("TimelineEventBroker", fields: [brokerUserId], references: [id], onDelete: SetNull)
  actorUser       User?       @relation("TimelineEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  documents       TimelineEventDocument[]

  @@index([portalInstanceId, eventDate])
  @@index([propertyId, eventDate])
  @@index([unitId, eventDate])
  @@index([tenantProfileId, eventDate])
  @@index([eventType])
  @@index([status])
}

model TimelineEventDocument {
  id              String        @id @default(cuid())
  timelineEventId String
  documentId      String
  createdAt       DateTime      @default(now())
  timelineEvent   TimelineEvent @relation(fields: [timelineEventId], references: [id], onDelete: Cascade)
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([timelineEventId, documentId])
  @@index([documentId])
}

model RentPayment {
  id              String    @id @default(cuid())
  unitId          String
  tenantProfileId String?
  year            Int
  month           Int
  expectedColdRent Decimal  @db.Decimal(12, 2)
  expectedServiceCharges Decimal @db.Decimal(12, 2)
  expectedTotalRent Decimal @db.Decimal(12, 2)
  paidColdRent    Decimal? @db.Decimal(12, 2)
  paidServiceCharges Decimal? @db.Decimal(12, 2)
  paidTotalRent   Decimal? @db.Decimal(12, 2)
  status          String   @default("OPEN")
  note            String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantProfile   TenantProfile? @relation(fields: [tenantProfileId], references: [id], onDelete: SetNull)

  @@unique([unitId, year, month])
  @@index([year, month])
}

model DocumentCategory {
  id          String       @id @default(cuid())
  portalInstanceId String?
  group       String
  name        String
  description String?
  visibleToBroker Boolean  @default(true)
  visibleToTenant Boolean  @default(false)
  createdAt   DateTime     @default(now())
  documents   Document[]
  portalInstance PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)

  @@unique([portalInstanceId, name])
}

model Document {
  id              String          @id @default(cuid())
  portalInstanceId String?
  title           String
  filename        String
  mimeType        String
  size            Int
  storagePath     String
  status          DocumentStatus  @default(AVAILABLE)
  scope           DocumentScope   @default(PROPERTY)
  propertyId      String?
  unitId          String?
  tenantProfileId String?
  categoryId      String?
  uploadedById    String
  isPropertyImage Boolean         @default(false)
  isPrimaryImage  Boolean         @default(false)
  summary         String?
  tags            String[]        @default([])
  ocrText         String?         @db.Text
  ocrStatus       String?
  ocrProcessedAt  DateTime?
  ocrError        String?
  documentYear    Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  property        Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit            Unit?           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantProfile   TenantProfile?  @relation(fields: [tenantProfileId], references: [id], onDelete: SetNull)
  category        DocumentCategory? @relation(fields: [categoryId], references: [id])
  uploadedBy      User            @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  permissions     AccessPermission[]
  exportItems     DocumentExportItem[]
  timelineEvents  TimelineEventDocument[]
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}

model DocumentExport {
  id               String          @id @default(cuid())
  portalInstanceId String?
  name             String
  description      String?         @db.Text
  createdById      String
  downloadedAt     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  portalInstance   PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
  createdBy        User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  items            DocumentExportItem[]

  @@index([portalInstanceId, createdAt])
}

model DocumentExportItem {
  id          String         @id @default(cuid())
  exportId    String
  documentId  String
  addedAt     DateTime       @default(now())
  export      DocumentExport @relation(fields: [exportId], references: [id], onDelete: Cascade)
  document    Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([exportId, documentId])
  @@index([documentId])
}

model PublicShare {
  id               String            @id @default(cuid())
  portalInstanceId String?
  slug             String            @unique
  name             String
  description      String?           @db.Text
  createdById      String
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  portalInstance   PortalInstance?   @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  files            PublicShareFile[]

  @@index([portalInstanceId, createdAt])
  @@index([expiresAt])
}

model PublicShareFile {
  id          String      @id @default(cuid())
  shareId     String
  sourceDocumentId String?
  filename    String
  mimeType    String
  size        Int
  storagePath String
  downloadCount Int       @default(0)
  lastDownloadedAt DateTime?
  createdAt   DateTime    @default(now())
  share       PublicShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId])
}

model AccessPermission {
  id          String    @id @default(cuid())
  userId      String
  documentId  String
  canView     Boolean   @default(true)
  canDownload Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
}

model BrokerRequest {
  id          String    @id @default(cuid())
  userId      String
  propertyId  String
  message     String?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model BrokerValuation {
  id          String    @id @default(cuid())
  userId      String
  propertyId  String
  amount      Decimal?  @db.Decimal(14, 2)
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model TenantProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  unitId                String?
  firstName             String
  lastName              String
  birthdate             DateTime?
  currentAddress        String?
  phone                 String?
  email                 String
  moveInDate            DateTime?
  moveOutDate           DateTime?
  isCurrent             Boolean   @default(true)
  leaseStartDate        DateTime?
  rentAmount            Decimal?  @db.Decimal(12, 2)
  garageRent            Decimal?  @db.Decimal(12, 2)
  serviceCharges        Decimal?  @db.Decimal(12, 2)
  deposit               Decimal?  @db.Decimal(12, 2)
  depositPaidAmount     Decimal?  @db.Decimal(12, 2)
  depositPaidAt         DateTime?
  depositReturnedAmount Decimal?  @db.Decimal(12, 2)
  depositReturnedAt     DateTime?
  depositStatus         String    @default("OPEN")
  occupantCount         Int?
  bankAccount           String?
  rentDueDay            Int?
  landlordBankAccount   String?
  landlordBankName      String?
  roomDescription       String?
  sharedRooms           String?
  steppedRent           String?
  contractNotes         String?
  pets                  String?
  specialAgreements     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit                  Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  contracts             LeaseContract[]
  documents             Document[]
  rentPayments          RentPayment[]
  timelineEvents        TimelineEvent[]
}

model ContractTemplate {
  id          String          @id @default(cuid())
  portalInstanceId String?
  propertyId  String?
  unitId      String?
  isGlobalTemplate Boolean    @default(true)
  name        String
  filename    String
  storagePath String
  mimeType    String
  size        Int
  createdAt   DateTime        @default(now())
  contracts   LeaseContract[]
  property    Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit        Unit?            @relation("TemplateAssignedUnit", fields: [unitId], references: [id], onDelete: SetNull)
  defaultForUnits Unit[]       @relation("UnitDefaultContractTemplate")
  portalInstance PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}

model LeaseContract {
  id              String            @id @default(cuid())
  unitId          String
  tenantProfileId String
  templateId      String?
  docxPath        String
  pdfPath         String?
  createdAt       DateTime          @default(now())
  unit            Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantProfile   TenantProfile     @relation(fields: [tenantProfileId], references: [id], onDelete: Cascade)
  template        ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model MailTemplate {
  id              String          @id @default(cuid())
  portalInstanceId String?
  key             String
  name            String
  description     String
  trigger         String
  subject         String
  text            String
  placeholders    String[]        @default([])
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)

  @@unique([portalInstanceId, key])
}

model TelegramBotConfig {
  id              String          @id @default(cuid())
  portalInstanceId String?        @unique
  botTokenEncrypted String
  botUsername     String?
  chatId          String?
  chatTitle       String?
  threadId        String?
  threadTitle     String?
  pendingChatId   String?
  pendingChatTitle String?
  pendingThreadId String?
  pendingThreadTitle String?
  pendingFrom     String?
  pendingText     String?
  pendingAt       DateTime?
  lastUpdateId    Int?
  webhookSecret   String          @default(cuid())
  webhookEnabled  Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
  conversations   TelegramConversation[]
}

model TelegramConversation {
  id              String            @id @default(cuid())
  telegramBotConfigId String
  chatId          String
  threadId        String            @default("")
  flow            String
  payload         Json
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  telegramBotConfig TelegramBotConfig @relation(fields: [telegramBotConfigId], references: [id], onDelete: Cascade)

  @@unique([telegramBotConfigId, chatId, threadId])
}

model AiProviderConfig {
  id              String          @id @default(cuid())
  portalInstanceId String?        @unique
  provider        String          @default("openai")
  apiKeyEncrypted String?
  embeddingModel  String          @default("text-embedding-3-small")
  transcriptionModel String       @default("gpt-4o-mini-transcribe")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}

model BankingIntegrationConfig {
  id              String          @id @default(cuid())
  portalInstanceId String?        @unique
  baseUrl         String          @default("https://banking.schreiber.info")
  apiTokenEncrypted String?
  lastSuccessfulAt DateTime?
  lastError       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}

model ServiceChargeRule {
  id                String          @id @default(cuid())
  portalInstanceId  String?
  propertyId        String
  year              Int
  method            String
  totalDistributionValue Decimal?   @db.Decimal(12, 4)
  note              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  portalInstance    PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
  property          Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitAllocations   ServiceChargeUnitAllocation[]
  statementLines    ServiceChargeStatementLine[]

  @@unique([propertyId, year])
  @@index([portalInstanceId, year])
}

model ServiceChargeUnitAllocation {
  id          String            @id @default(cuid())
  ruleId      String
  unitId      String
  value       Decimal           @db.Decimal(12, 4)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  rule        ServiceChargeRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  unit        Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([ruleId, unitId])
}

model ServiceChargeStatementLine {
  id              String            @id @default(cuid())
  portalInstanceId String?
  ruleId          String
  unitId          String?
  description     String
  amount          Decimal           @db.Decimal(12, 2)
  treatment       String
  sourceReference String?
  note            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  portalInstance  PortalInstance?   @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
  rule            ServiceChargeRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  unit            Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([ruleId, treatment])
  @@index([portalInstanceId, createdAt])
}

model ServiceChargeStatement {
  id               String          @id @default(cuid())
  portalInstanceId String?
  propertyId       String
  year             Int
  version          Int
  status           String          @default("DRAFT")
  snapshot         Json
  checksum         String
  createdByUserId  String
  finalizedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  portalInstance   PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
  property         Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy        User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([propertyId, year, version])
  @@index([portalInstanceId, year, status])
  @@index([propertyId, year, deletedAt])
}

model AgentConfig {
  id              String          @id @default(cuid())
  portalInstanceId String?        @unique
  systemPrompt    String          @db.Text
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}

model AgentConversation {
  id              String          @id @default(cuid())
  portalInstanceId String?
  userId          String?
  channel         String          @default("web")
  externalKey     String?
  title           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  portalInstance  PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
  messages        AgentMessage[]
  state           AgentConversationState?
  runLogs         AgentRunLog[]

  @@index([portalInstanceId, channel, externalKey])
}

model AgentConversationState {
  id              String          @id @default(cuid())
  conversationId  String          @unique
  goal            String?
  status          String          @default("idle")
  facts           Json?
  pendingQuestion String?         @db.Text
  pendingTool     String?
  plan            Json?
  lastEntityRefs  Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  conversation    AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AgentMessage {
  id              String          @id @default(cuid())
  conversationId  String
  role            String
  content         String          @db.Text
  createdAt       DateTime        @default(now())
  conversation    AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AgentRunLog {
  id               String          @id @default(cuid())
  conversationId   String
  portalInstanceId String?
  userId           String?
  channel          String          @default("web")
  userInput        String          @db.Text
  systemPrompt     String?         @db.Text
  modelContext     Json?
  modelResponses   Json?
  toolCalls        Json?
  toolResults      Json?
  finalAnswer      String?         @db.Text
  error            String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  conversation     AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([portalInstanceId, createdAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  portalInstanceId String?
  userId    String?
  action    AuditAction
  entity    String?
  entityId  String?
  ipAddress String?
  detail    Json?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  portalInstance PortalInstance? @relation(fields: [portalInstanceId], references: [id], onDelete: Cascade)
}
